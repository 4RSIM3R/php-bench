# Dockerfile for PHP 8.4 without OPcache
FROM php:8.4-cli

# Install required extensions
RUN docker-php-ext-install -j$(nproc) \
    bcmath

# Disable OPcache explicitly
RUN echo "opcache.enable=0" >> /usr/local/etc/php/conf.d/opcache.ini
RUN echo "opcache.enable_cli=0" >> /usr/local/etc/php/conf.d/opcache.ini

# Set PHP configuration for benchmarking
RUN echo "memory_limit=512M" >> /usr/local/etc/php/conf.d/benchmark.ini
RUN echo "max_execution_time=300" >> /usr/local/etc/php/conf.d/benchmark.ini
RUN echo "display_errors=On" >> /usr/local/etc/php/conf.d/benchmark.ini

# Create working directory
WORKDIR /app

# Copy the benchmark script
COPY bench_obfuscate.php /app/

# Create output directory
RUN mkdir -p /app/output

# Set the default command to run the benchmark and save output
CMD ["sh", "-c", "php bench_obfuscate.php 2>&1 | tee /app/output/benchmark_no_opcache_$(date +%Y%m%d_%H%M%S).log && cp benchmark_results_*.json /app/output/ 2>/dev/null || true"]